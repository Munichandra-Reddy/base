# ==============================================================================
# WorkOrbit Environment Variables Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Frontend Authentication & Database)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyAFJCJ5JqYohhGXxn7XmPtxyaWZpMiaR3k"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="workorbit-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="workorbit-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="workorbit-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="850265976443"
NEXT_PUBLIC_FIREBASE_APP_ID="1:850265976443:web:3f9b4d1d840246c24d7cde"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-SZW1VETMQQ"

# ------------------------------------------------------------------------------
# 2. Official WhatsApp Business Platform Cloud API (Server-side Node.js Runtime)
# Meta for Developers Portal: https://developers.facebook.com/apps/
# ------------------------------------------------------------------------------

# Permanent System User Access Token with 'whatsapp_business_messaging' scope
# NEVER expose this token to the frontend client!
WHATSAPP_API_TOKEN="your_meta_system_user_access_token_here"

# WhatsApp Business Phone Number ID from App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id_here"

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id_here"

# Webhook Verification Secret Token (Must match the verify token in Meta Webhooks settings)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="workorbit_secure_verify_token_2026"

# Meta App Secret used for cryptographic HMAC-SHA256 signature verification (X-Hub-Signature-256)
WHATSAPP_APP_SECRET="your_meta_app_secret_here"

# Mode toggle: Set to "true" to run in safe simulated Demo Mode (no charges, full test UI & audit logs)
# Set to "false" to dispatch real live messages to recipient WhatsApp devices via Meta Cloud API
WHATSAPP_DEMO_MODE="true"
