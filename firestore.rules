rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'cr7156816@gmail.com' ||
        request.auth.token.role == 'admin'
      );
    }

    // User Accounts collection: Protect credentials
    match /user_accounts/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if true; // Allows initial signup
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Employees Directory: Readable by team, writable only by Admin
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects: Readable by team, created/deleted only by Admin
    match /projects/{projectId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated();
    }

    // Tasks: Readable and updatable by team, deleted only by Admin
    match /tasks/{taskId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Chat Messages: Readable and sendable by team
    match /chat_messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Check-ins & Status updates
    match /checkins/{checkinId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Password Reset tokens: Strict single-use and expiration check
    match /password_resets/{emailId} {
      allow read, write: if true;
    }
  }
}