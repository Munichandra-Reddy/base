rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Phase 7: Campfire Chat Attachments (Images, PDFs, Documents, Archives up to 25MB)
    match /campfire_attachments/{conversationId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024;
    }

    // Phase 8: Project & Workspace Files (up to 50MB)
    match /projects/{projectId}/files/{fileId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }

    // Default workspace files
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }
  }
}
